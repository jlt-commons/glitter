;; screen-grab manifest for glitter's interactive demos.
;; https://github.com/burinc/b12n-screen-grab
;;
;; Driver is :spawn — each demo is launched fresh via `jolt -M:<id>`, captured,
;; and torn down. Steering is KEYBOARD ONLY: screen-grab's own README is
;; explicit that :click/:move/:drag move the cursor but their press is never
;; processed by the target app, so a GTK button cannot be clicked this way.
;; Tab/Space/Enter/typing all work, and GTK's focus ring makes the keyboard
;; path legible on screen anyway.
{:driver  :spawn
 :capture :cgevent-gif

 :examples-cmd "bb demos:examples"

 :out-dir "docs/demos"
 :ledger  "docs/demos/ledger.edn"
 :readme  "docs/demos/README.md"
 :title   "Demos"
 :preamble "Animated previews of glitter's interactive demos. Regenerate with `bb record` (maintainer-only: it needs an internal capture tool that is not publicly released). The GIFs here are committed, so you do not need it to browse them."

 :groups [{:key "basics"  :title "basics"}
          {:key "7guis"   :title "7GUIs tasks"}
          {:key "gallery" :title "widget gallery"}]

 :defaults {:duration 8 :fps 10 :width 520 :warmup 12}

 :overrides
 {;; Tab moves focus to the "+ 1" button, Space presses it. Repeated so the
  ;; count visibly climbs rather than ticking once.
  "counter"     {:input [[1.5 :key "tab"] [2.5 :key "space"] [3.5 :key "space"]
                         [4.5 :key "space"] [5.5 :key "space"] [6.5 :key "space"]]}

  ;; No typing here, deliberately. :type against GTK repeats characters on
  ;; this setup ("write the guide" arrived as "wriiiiiteeeee g", verified
  ;; live), which looks broken in a published GIF. Single characters are
  ;; fine - see "crud" below - but a whole task title is not. Toggling the
  ;; three checkbuttons with Space shows the derived counts recomputing,
  ;; which is what this demo is actually about.
  "todo"        {:input [[1.5 :key "space"] [3.0 :key "tab"] [3.5 :key "space"]
                         [5.0 :key "tab"] [5.5 :key "space"] [7.0 :key "space"]]
                 :duration 9}

  ;; Type into the filter field to show the live prefix filter, which is the
  ;; part of the CRUD task worth seeing.
  ;; Single characters only (see "todo"). "M" narrows to Mustermann and "T"
  ;; to Tisch - both real matches. An earlier take filtered on "R", which
  ;; matches nothing, so the GIF showed an empty list: technically correct
  ;; filtering, but it reads as a broken demo.
  "crud"        {:input [[2.0 :type "M"] [4.5 :key "backspace"] [6.0 :type "T"]]
                 :duration 9}

  ;; Editing one field updates the other eagerly - the whole point of the task.
  "temperature" {:input [[2.0 :type "100"] [5.0 :key "tab"]] :duration 9}

  ;; Tab into the date field and make it invalid, so the red ill-formatted
  ;; state and the disabled Book button both show.
  "flights"     {:input [[2.0 :key "tab"] [3.0 :type "x"] [6.0 :key "backspace"]]
                 :duration 9}

  ;; Needs no input at all: the elapsed bar advances on its own. This is the
  ;; only demo whose state changes without a user, so it is the one item here
  ;; that would animate even with an empty timeline.
  "timer"       {:duration 10}

  ;; --- widget galleries ----------------------------------------------------
  ;; These are reference pages more than tasks, so the steering just walks the
  ;; focus chain: Tab to the next widget, Space/typing to work it. Same two
  ;; constraints as above — a click never reaches GTK, and :type repeats
  ;; characters, so single characters only.

  ;; Tab lands in the entry first. Type into it, then Tab on through the
  ;; password and search fields so the state readout at the bottom visibly
  ;; recomputes on every keystroke.
  "gallery-inputs"  {:input [[1.5 :key "tab"] [2.0 :type "a"] [3.0 :key "tab"]
                             [3.5 :type "b"] [4.5 :key "tab"] [5.0 :type "c"]
                             [6.5 :key "tab"] [7.0 :key "space"]]
                     :duration 10 :width 560}

  ;; Tab to the divider scale and drive it with the arrow keys — the paned
  ;; divider moves because state moved, which is the point of the page.
  "gallery-layout"  {:input [[1.5 :key "tab"] [2.5 :key "right"] [3.0 :key "right"]
                             [3.5 :key "right"] [4.5 :key "left"] [5.0 :key "left"]
                             [6.0 :key "tab"] [6.5 :key "space"]]
                     :duration 10 :width 620}

  ;; One scale drives nine widgets. Arrow keys walk it up and back down so the
  ;; progress bar, level bar, icon size and inscription all move together.
  "gallery-display" {:input [[1.5 :key "tab"] [2.5 :key "right"] [3.0 :key "right"]
                             [3.5 :key "right"] [4.0 :key "right"] [5.0 :key "left"]
                             [5.5 :key "left"] [6.5 :key "tab"] [7.0 :key "space"]]
                     :duration 10 :width 560}

  ;; Tab to the menu button and Space to open the popover, then on to the
  ;; stack buttons. The notebook and stack have already dispatched once each
  ;; by the time the first frame is captured — see gallery_smoke.clj.
  "gallery-chrome"  {:input [[1.5 :key "tab"] [2.0 :key "space"] [3.5 :key "escape"]
                             [4.5 :key "tab"] [5.0 :key "space"] [6.5 :key "tab"]
                             [7.0 :key "space"]]
                     :duration 10 :width 560}}}
