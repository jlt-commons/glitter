;; Babashka runner for glitter — a Replicant-style GTK4 renderer for Jolt.
;;   bb info               grouped task cheat-sheet (start here)
;;   bb test                run the unit suite (jolt -M:test)
;;   bb counter              interactive counter demo (state atom + action dispatch)
;;   bb todo                 interactive task-board demo (derived counts, entry, checkbuttons)
;;   bb smoke | keyed | replace-child | aliased | main-thread-smoke | scale-smoke | class-smoke
;;   | leaf-widgets-smoke | toggle-level-smoke | link-button-smoke | switch-smoke
;;   | revealer-center-box-smoke | spin-button-list-box-smoke
;;   | password-search-entry-smoke | expander-paned-smoke
;;   | aspect-frame-calendar-smoke | overlay-flow-box-smoke
;;                           individual live-GTK smokes (each exits non-zero on failure)
;;   bb smokes               run every live-GTK smoke in sequence; stops at first failure
;;   bb lint | lint:strict   clj-kondo over glitter-authored code; :strict propagates findings
;;   bb lsp:format | lsp:format-check       clojure-lsp format (mutate | dry-run)
;;   bb lsp:clean-ns | lsp:clean-ns-check   clojure-lsp clean-ns (mutate | dry-run)
;;   bb lsp:diagnostics | lsp:check | lsp:fix   diagnostics | all dry-run checks | auto-fix
;;   bb check:positional-args | :strict     find fns with 3+ positional args
;;   bb verify                lint (report) + test (must pass) — pre-commit gate
;;   bb hooks:install | hooks:install:full | hooks:uninstall   git pre-commit hook
;;   bb nrepl [port]           start a jolt nREPL server (default 7888)
;; NOTE: task bodies are EDN-parsed — no #"regex", @deref, or #(...) reader macros.
;; NOTE: every jolt task below shells out to `jolt -M:<alias>`, never the deps.edn
;; `jolt <task>` shorthand — verified against jolt v0.6.3, the task form does not
;; propagate its child process's exit status, so a failing smoke would print FAIL
;; on stdout and still exit 0 (see README's CI note). `-M:<alias>` exits correctly.
{:min-bb-version "1.3.0"
 :tasks
 {:requires ([babashka.fs :as fs])

  info {:doc "Grouped task cheat-sheet (start here; easier to scan than `bb tasks`)"
        :task
        (let [esc (str (char 27) "[")
              col (fn [c s] (str esc c "m" s esc "0m"))
              hdr (fn [s] (println (str "\n" (col "35" (str "── " s " ──")))))
              row (fn [t d] (println (str "  " (col "36" (format "%-33s" (str "bb " t))) d)))]
          (println (col "1;35" "\nglitter — Replicant-style GTK4 renderer for Jolt"))
          (hdr "Verify")
          (row "test" "run the unit suite (jolt -M:test)")
          (row "verify" "lint (report) + test (must pass) — pre-commit gate")
          (hdr "Run")
          (row "counter" "interactive demo: state atom + action dispatch")
          (row "todo" "interactive demo: derived counts, entry, checkbuttons")
          (hdr "Smoke (live GTK, each exits non-zero on failure)")
          (row "smoke" "mount a tree and run the loop without an exception escaping")
          (row "keyed" "keyed reorder lands in the right GTK order")
          (row "replace-child" "a replaced child stays at its position, not the end")
          (row "aliased" "aliases expand through the real renderer, on mount and update")
          (row "main-thread-smoke" "an off-main-thread swap! renders ON the GTK main thread")
          (row "scale-smoke" "GtkScale's value-changed signal delivers the right double, no spurious dispatch")
          (row "class-smoke" ":class reaches real GTK CSS classes — add, coexist, and remove on diff")
          (row "leaf-widgets-smoke" ":spinner/:progress-bar/:image construction + re-render, real GTK state")
          (row "toggle-level-smoke" ":toggle-button's toggled signal + :level-bar construction/re-render")
          (row "link-button-smoke" ":link-button reuses :on-click; real click via gtk_widget_activate")
          (row "switch-smoke" ":switch's state-set signal (3-arg, non-void return) via a generalized callable")
          (row "revealer-center-box-smoke" ":revealer's props-driven reveal; :center-box's 3 named slots")
          (row "spin-button-list-box-smoke" ":spin-button's tag-safe value-fn; :list-box's row-selected + container fixes")
          (row "password-search-entry-smoke" ":password-entry/:search-entry reuse :entry's GtkEditable signal")
          (row "expander-paned-smoke" ":expander/:paned's notify::* signals reuse the round-6 3-arg-void shape")
          (row "aspect-frame-calendar-smoke" ":aspect-frame's single-child reuse; :calendar's GDateTime round-trip")
          (row "overlay-flow-box-smoke" ":overlay's 1-main+N-overlay shape; :flow-box's list-box-lesson reuse")
          (row "smokes" "run every smoke above in sequence; stops at the first failure")
          (hdr "Quality — lint/format/checks")
          (row "lint" "clj-kondo over glitter-authored code (report only)")
          (row "lint:strict" "bb lint, but exit non-zero if any findings")
          (row "lsp:format" "reformat all Clojure files (clojure-lsp)")
          (row "lsp:format-check" "check formatting — dry run")
          (row "lsp:clean-ns" "clean + organize ns forms (clojure-lsp)")
          (row "lsp:clean-ns-check" "check ns forms — dry run")
          (row "lsp:diagnostics" "clojure-lsp diagnostics")
          (row "lsp:check" "all LSP checks (format + clean-ns + diagnostics) — dry run")
          (row "lsp:fix" "auto-fix: format + clean-ns (mutating)")
          (row "check:positional-args" "find fns with 3+ positional args (report only)")
          (row "check:positional-args:strict" "bb check:positional-args, but exit non-zero if any found")
          (hdr "Git hooks")
          (row "hooks:install" "install FAST pre-commit hook (lint errors + clean-ns, ~2s)")
          (row "hooks:install:full" "install FULL pre-commit hook (+ unit tests, slower)")
          (row "hooks:uninstall" "remove the git pre-commit hook")
          (hdr "Dev")
          (row "nrepl [port]" "start a jolt nREPL server (default 7888)")
          (println (str "\n" (col "2" "first run: bb test, then bb counter  ·  CI gate: bb test && bb smokes"))))}

  test {:doc "Run the unit suite"
        :task (shell "jolt" "-M:test")}

  counter {:doc "Interactive counter demo (state atom + action dispatch)"
           :task (shell "jolt" "-M:counter")}

  todo {:doc "Interactive task-board demo (derived counts, entry, checkbuttons)"
        :task (shell "jolt" "-M:todo")}

  smoke {:doc "Live-GTK smoke: mount a tree, run the loop without an exception escaping"
         :task (shell "jolt" "-M:smoke")}

  keyed {:doc "Live-GTK smoke: keyed reorder lands in the right GTK order"
         :task (shell "jolt" "-M:keyed")}

  replace-child {:doc "Live-GTK smoke: a replaced child stays at its position, not the end"
                 :task (shell "jolt" "-M:replace-child")}

  aliased {:doc "Live-GTK smoke: aliases expand through the real renderer, on mount and update"
           :task (shell "jolt" "-M:aliased")}

  main-thread-smoke {:doc "Live-GTK smoke: an off-main-thread swap! renders ON the GTK main thread"
                     :task (shell "jolt" "-M:main-thread-smoke")}

  scale-smoke {:doc "Live-GTK smoke: GtkScale's value-changed signal delivers the right double, no spurious dispatch"
               :task (shell "jolt" "-M:scale-smoke")}

  class-smoke {:doc "Live-GTK smoke: :class reaches real GTK CSS classes — add, coexist, and remove on diff"
               :task (shell "jolt" "-M:class-smoke")}

  leaf-widgets-smoke {:doc "Live-GTK smoke: :spinner/:progress-bar/:image construction + re-render, real GTK state"
                      :task (shell "jolt" "-M:leaf-widgets-smoke")}

  toggle-level-smoke {:doc "Live-GTK smoke: :toggle-button's toggled signal + :level-bar construction/re-render"
                      :task (shell "jolt" "-M:toggle-level-smoke")}

  link-button-smoke {:doc "Live-GTK smoke: :link-button reuses :on-click; real click via gtk_widget_activate"
                     :task (shell "jolt" "-M:link-button-smoke")}

  switch-smoke {:doc "Live-GTK smoke: :switch's state-set signal (3-arg, non-void return) via a generalized callable"
                :task (shell "jolt" "-M:switch-smoke")}

  revealer-center-box-smoke {:doc "Live-GTK smoke: :revealer's props-driven reveal/transition; :center-box's 3 named slots"
                             :task (shell "jolt" "-M:revealer-center-box-smoke")}

  spin-button-list-box-smoke {:doc "Live-GTK smoke: :spin-button's tag-safe value-fn; :list-box's row-selected + container-management fixes"
                              :task (shell "jolt" "-M:spin-button-list-box-smoke")}

  password-search-entry-smoke {:doc "Live-GTK smoke: :password-entry/:search-entry reuse :entry's GtkEditable-delegate \"changed\" signal"
                               :task (shell "jolt" "-M:password-search-entry-smoke")}

  expander-paned-smoke {:doc "Live-GTK smoke: :expander/:paned's notify::* signals reuse the round-6 3-arg-void callable shape"
                        :task (shell "jolt" "-M:expander-paned-smoke")}

  aspect-frame-calendar-smoke {:doc "Live-GTK smoke: :aspect-frame's single-child container reuse; :calendar's GDateTime refcounted round-trip"
                               :task (shell "jolt" "-M:aspect-frame-calendar-smoke")}

  overlay-flow-box-smoke {:doc "Live-GTK smoke: :overlay's 1-main+N-overlay shape; :flow-box's list-box-lesson reuse (and a verified difference)"
                          :task (shell "jolt" "-M:overlay-flow-box-smoke")}

  smokes {:doc "Run every live-GTK smoke in sequence (CI gate); stops at the first failure"
          :task (do (shell "jolt" "-M:smoke")
                    (shell "jolt" "-M:keyed")
                    (shell "jolt" "-M:replace-child")
                    (shell "jolt" "-M:aliased")
                    (shell "jolt" "-M:main-thread-smoke")
                    (shell "jolt" "-M:scale-smoke")
                    (shell "jolt" "-M:class-smoke")
                    (shell "jolt" "-M:leaf-widgets-smoke")
                    (shell "jolt" "-M:toggle-level-smoke")
                    (shell "jolt" "-M:link-button-smoke")
                    (shell "jolt" "-M:switch-smoke")
                    (shell "jolt" "-M:revealer-center-box-smoke")
                    (shell "jolt" "-M:spin-button-list-box-smoke")
                    (shell "jolt" "-M:password-search-entry-smoke")
                    (shell "jolt" "-M:expander-paned-smoke")
                    (shell "jolt" "-M:aspect-frame-calendar-smoke")
                    (shell "jolt" "-M:overlay-flow-box-smoke"))}

  ;; --- Quality: lint / format / positional-args ---------------------------
  ;; clj-kondo's exit code is a severity ladder: 0 = clean, 2 = warnings
  ;; only, 3 = errors present. `lint`/`verify` report and always exit 0;
  ;; `lint:strict` propagates the raw code; `lint:errors` (used by the git
  ;; hooks below) fails ONLY on real errors (exit 3), never on the 2
  ;; known-legitimate warnings (see .clj-kondo/config.edn's :exclude-files
  ;; comment and docs/guide/testing-and-tasks.md for why those aren't
  ;; worth silencing). Every task below lints `src test examples` directly
  ;; — no manual file list — because .clj-kondo/config.edn's
  ;; :output {:exclude-files [...]} already scopes out the 10 files ported
  ;; verbatim from Replicant (permanent, harmless "reader conditionals only
  ;; in .cljc" syntax findings; not a real defect — see that config's own
  ;; comment) at the config level, so an un-scoped invocation is safe here
  ;; too, not just in these tasks.
  lint {:doc "clj-kondo over glitter-authored code (report only, always exits 0)"
        :task (let [{:keys [exit]} (shell {:continue true} "clj-kondo" "--lint" "src" "test" "examples")]
                (println (if (zero? exit) "OK lint: clean" "!! lint: see findings above")))}

  lint:strict {:doc "bb lint, but exit non-zero if clj-kondo reports any findings (2=warnings, 3=errors)"
               :task (let [{:keys [exit]} (shell {:continue true} "clj-kondo" "--lint" "src" "test" "examples")]
                       (System/exit exit))}

  lint:errors {:doc "bb lint, but exit non-zero ONLY on real errors (exit 3) — ignores known warnings; used by git hooks"
               :task (let [{:keys [exit]} (shell {:continue true} "clj-kondo" "--lint" "src" "test" "examples")]
                       (System/exit (if (= 3 exit) 1 0)))}

  lsp:format {:doc "Reformat all Clojure files (clojure-lsp)"
              :task (let [{:keys [exit]} (shell {:continue true} "clojure-lsp" "format")]
                      (if (zero? exit)
                        (println "OK formatted")
                        (do (println "!! format failed") (System/exit exit))))}

  lsp:format-check {:doc "Check formatting (dry run)"
                    :task (let [{:keys [exit]} (shell {:continue true} "clojure-lsp" "format" "--dry")]
                            (if (zero? exit)
                              (println "OK all files formatted")
                              (do (println "!! files need formatting — run bb lsp:format")
                                  (System/exit exit))))}

  lsp:clean-ns {:doc "Clean + organize ns forms (clojure-lsp)"
                :task (let [{:keys [exit]} (shell {:continue true} "clojure-lsp" "clean-ns")]
                        (if (zero? exit)
                          (println "OK namespaces cleaned")
                          (do (println "!! clean-ns failed") (System/exit exit))))}

  lsp:clean-ns-check {:doc "Check ns forms (dry run)"
                      :task (let [{:keys [exit]} (shell {:continue true} "clojure-lsp" "clean-ns" "--dry")]
                              (if (zero? exit)
                                (println "OK all ns forms clean")
                                (do (println "!! ns forms need cleaning — run bb lsp:clean-ns")
                                    (System/exit exit))))}

  ;; clojure-lsp's own :diagnostics command runs clj-kondo under the hood,
  ;; so it also respects .clj-kondo/config.edn's :exclude-files and
  ;; :output/:hooks — same 2 known-legitimate warnings, no ported-file
  ;; noise.
  lsp:diagnostics {:doc "clojure-lsp diagnostics"
                   :task (let [{:keys [exit]} (shell {:continue true} "clojure-lsp" "diagnostics")]
                           (if (zero? exit)
                             (println "OK no diagnostics")
                             (println "!! diagnostics found (see above)")))}

  lsp:check {:doc "All LSP checks (format + clean-ns + diagnostics) — dry run"
             :task (do (println "-> LSP checks (dry run)")
                       (println "-> format --dry")
                       (shell {:continue true} "clojure-lsp" "format" "--dry")
                       (println "-> clean-ns --dry")
                       (shell {:continue true} "clojure-lsp" "clean-ns" "--dry")
                       (println "-> diagnostics")
                       (shell {:continue true} "clojure-lsp" "diagnostics")
                       (println "OK LSP checks done (see above for any issues)"))}

  lsp:fix {:doc "Auto-fix: format + clean-ns (mutating)"
           :task (do (println "-> LSP auto-fix")
                     (println "-> format")
                     (shell {:continue true} "clojure-lsp" "format")
                     (println "-> clean-ns")
                     (shell {:continue true} "clojure-lsp" "clean-ns")
                     (println "OK auto-fixes applied — run bb lsp:diagnostics + bb test to confirm"))}

  check:positional-args {:doc "Find fns with 3+ positional args (prefer a kwargs map)"
                         :task (let [{:keys [exit]} (shell {:continue true} "bb" "scripts/check_positional_args.clj")]
                                 (System/exit exit))}

  check:positional-args:strict {:doc "check:positional-args, but fail (exit 1) if any found"
                                :task (let [{:keys [exit]} (shell {:continue true} "bb" "scripts/check_positional_args.clj" "--strict")]
                                        (System/exit exit))}

  verify {:doc "Pre-commit gate: lint (report only) + test (must pass)"
          :task (do (println "-> verify: lint + test")
                    (shell {:continue true} "clj-kondo" "--lint" "src" "test" "examples")
                    (shell "jolt" "-M:test")
                    (println "OK verify passed"))}

  ;; --- Git hooks ------------------------------------------------------------
  ;; FAST hook: lint errors-only (ignores the 2 known-legitimate warnings —
  ;; see lint:errors above) + clean-ns dry-run. No `format --dry` here: the
  ;; codebase currently has drift against clojure-lsp's default cljfmt
  ;; style in a few files (map/binding-form line-wrapping choices), left
  ;; unresolved deliberately rather than auto-fixed — clojure-lsp's default
  ;; wraps `{:keys [x] :as y}` destructuring across two lines even when it
  ;; fits on one, which upstream Replicant's own source does NOT do (verified
  ;; against replicant.core directly), so blindly running `bb lsp:format`
  ;; on the files ported from it would both read worse than the hand-tuned
  ;; original AND reduce future diffability against upstream for no
  ;; benefit. Not wired into any gate until that's resolved one way or the
  ;; other. `bb lsp:format-check`/`bb lsp:format` remain available as
  ;; on-demand tools.
  hooks:install {:doc "Install FAST git pre-commit hook (lint errors + clean-ns, ~2s)"
                 :task (let [hook ".git/hooks/pre-commit"]
                         (spit hook (str "#!/bin/bash\n"
                                         "# glitter pre-commit (FAST — lint errors-only + clean-ns dry-run).\n"
                                         "# Full (+ test suite): bb hooks:install:full\n"
                                         "echo 'pre-commit 1/2: clj-kondo (errors only; known warnings accepted)'\n"
                                         "clj-kondo --lint src test examples\n"
                                         "LINT_EXIT=$?\n"
                                         "if [ \"$LINT_EXIT\" = \"3\" ]; then echo 'pre-commit: lint errors found'; exit 1; fi\n"
                                         "echo 'pre-commit 2/2: clojure-lsp clean-ns --dry'\n"
                                         "clojure-lsp clean-ns --dry || { echo 'run bb lsp:clean-ns'; exit 1; }\n"
                                         "exit 0\n"))
                         (shell "chmod" "+x" hook)
                         (println "OK fast pre-commit hook installed")
                         (println ">> skip once with: git commit --no-verify"))}

  hooks:install:full {:doc "Install FULL git pre-commit hook (lint errors + clean-ns + unit tests, slower)"
                      :task (let [hook ".git/hooks/pre-commit"]
                              (spit hook (str "#!/bin/bash\n"
                                              "# glitter pre-commit (FULL). Fast: bb hooks:install\n"
                                              "echo 'pre-commit 1/3: clj-kondo (errors only; known warnings accepted)'\n"
                                              "clj-kondo --lint src test examples\n"
                                              "LINT_EXIT=$?\n"
                                              "if [ \"$LINT_EXIT\" = \"3\" ]; then echo 'pre-commit: lint errors found'; exit 1; fi\n"
                                              "echo 'pre-commit 2/3: clojure-lsp clean-ns --dry'\n"
                                              "clojure-lsp clean-ns --dry || { echo 'run bb lsp:clean-ns'; exit 1; }\n"
                                              "echo 'pre-commit 3/3: unit tests'\n"
                                              "jolt -M:test\n"
                                              "exit $?\n"))
                              (shell "chmod" "+x" hook)
                              (println "OK full pre-commit hook installed")
                              (println ">> skip once with: git commit --no-verify"))}

  hooks:uninstall {:doc "Remove the git pre-commit hook"
                   :task (let [hook ".git/hooks/pre-commit"]
                           (if (fs/exists? hook)
                             (do (fs/delete hook) (println "OK pre-commit hook removed"))
                             (println ">> no pre-commit hook found")))}

  ;; --- Dev & REPL -----------------------------------------------------------
  nrepl {:doc "Start a jolt nREPL server for interactive dev: bb nrepl [port] (default 7888)"
         :task (shell "jolt" "nrepl-server" (or (first *command-line-args*) "7888"))}}}
