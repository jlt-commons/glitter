{:paths ["src"]

 :deps {weavejester/hiccup
        {:git/url "https://github.com/weavejester/hiccup"
         :git/sha "b6b12097ba973141fe87c1b4d6a27ddcce5d5929"}}

 ;; GTK4 and its GLib dependencies, bound natively via jolt.ffi. Identical
 ;; declarations to glimmer's deps.edn (~/dev/glimmer/deps.edn) — glitter
 ;; targets the same native libraries, just a different reconciler on top.
 :jolt/native [{:name "glib-2.0"
                :darwin ["/opt/homebrew/lib/libglib-2.0.0.dylib"
                         "/usr/local/lib/libglib-2.0.0.dylib"
                         "libglib-2.0.0.dylib" "libglib-2.0.dylib"]
                :linux  ["libglib-2.0.so.0" "libglib-2.0.so"]}
               {:name "gobject-2.0"
                :darwin ["/opt/homebrew/lib/libgobject-2.0.0.dylib"
                         "/usr/local/lib/libgobject-2.0.0.dylib"
                         "libgobject-2.0.0.dylib" "libgobject-2.0.dylib"]
                :linux  ["libgobject-2.0.so.0" "libgobject-2.0.so"]}
               {:name "gio-2.0"
                :darwin ["/opt/homebrew/lib/libgio-2.0.0.dylib"
                         "/usr/local/lib/libgio-2.0.0.dylib"
                         "libgio-2.0.0.dylib" "libgio-2.0.dylib"]
                :linux  ["libgio-2.0.so.0" "libgio-2.0.so"]}
               {:name "gtk-4"
                :darwin ["/opt/homebrew/lib/libgtk-4.1.dylib"
                         "/usr/local/lib/libgtk-4.1.dylib"
                         "libgtk-4.1.dylib" "libgtk-4.dylib"]
                :linux  ["libgtk-4.so.1" "libgtk-4.so"]}]

 :aliases {:test    {:extra-paths ["test"]     :main-opts ["-m" "glitter.test-runner"]}
           :counter {:extra-paths ["examples"] :main-opts ["-m" "glitter.counter"]}
           :smoke   {:extra-paths ["examples"] :main-opts ["-m" "glitter.smoke"]}
           :keyed   {:extra-paths ["examples"] :main-opts ["-m" "glitter.keyed"]}}

 :tasks {test    "jolt -M:test"
         counter "jolt -M:counter"
         smoke   "jolt -M:smoke"
         keyed   "jolt -M:keyed"}}
