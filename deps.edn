{:paths ["src"]

 ;; The oldest jolt glitter runs on, declared so a runtime below it refuses
 ;; to load rather than run wrong (jolt #804). A library is the natural
 ;; declarer, since it knows what its bindings need and the app pulling it
 ;; in does not. Think twice before RAISING this: the floor is enforced on
 ;; every consumer too (:jolt/required-by), not just here, so raise it only
 ;; for something glitter needs. (Why 0.7.24 was the original floor: git
 ;; blame, or docs/guide/nexus.md.)
 ;;
 ;; glitter's own code has never needed more than 0.7.24. The floor went to
 ;; 0.8.0 when glitter started depending on glitter-core, whose deps.edn
 ;; declares that floor. It is now 0.8.24 because jolt-lang/time v0.0.16 and
 ;; later need jolt v0.8.24 (see the time pin below) but don't declare
 ;; :jolt/min-version themselves, so nothing else in the graph enforces it.
 ;; CI already pins 0.8.24.
 :jolt/min-version "0.8.24"

 ;; jolt-lang/time provides the java.time.* classes as a pure-Clojure host
 ;; shim, with juxt/tick (pulled in through jolt-lang/time's own deps.edn) as
 ;; the date/time API on top. examples/glitter/flights.clj uses it to parse,
 ;; format and compare dates. jolt-lang/logging ports clojure.tools.logging,
 ;; and glitter.nexus consumers use it as the :nexus/on-error handler. Both
 ;; SHAs were verified live under Jolt, not just JVM Clojure, when they were
 ;; pinned. Re-verify live before bumping either.
 ;;
 ;; The time SHA is a FLOOR, not just a snapshot. Each release below fixed
 ;; something glitter depends on, and each one breaks silently if the pin
 ;; moves back past it:
 ;;
 ;; v0.0.7 made (t/today) answer the machine's zone instead of UTC. Older
 ;; pins put flights.clj's departure field back on the UTC date.
 ;;
 ;; v0.0.8 carries jolt-lang/time#11 (commit 33c5e98), which declares the
 ;; java.time classes the library provides (jolt #813 / RFC 0014). Without
 ;; it, a jolt carrying #813 can't resolve java.time.ZoneId at all: `jolt
 ;; flights` dies, and glitter.nexus.action-log-test drops out of the suite
 ;; (29 tests down to 26) with a clean exit.
 ;;
 ;; v0.0.15 fixed locale_data.clj's ns docstring. In v0.0.8 it had unescaped
 ;; quotes that jolt 0.8.x rejects, so tick.core (and `jolt flights`) failed
 ;; to load.
 ;;
 ;; v0.0.16 is the first release that leaves `jolt build --tree-shake`
 ;; working for apps that require it (jolt-lang/time#28). It needs jolt
 ;; v0.8.24 or newer, which is why :jolt/min-version above is 0.8.24.
 ;;
 ;; v0.0.18, the current pin, makes ZoneId/of, OffsetDateTime/parse and
 ;; ZonedDateTime/parse follow java.time: ISO parsing, the JDK's exception
 ;; types for bad input, and a ZoneOffset back for an offset id
 ;; (jolt-lang/time#31, #32, #33, #35).
 ;;
 ;; The two use different Maven-coordinate conventions on purpose:
 ;; io.github.jolt-lang/time is a normal git-coordinate dep, but
 ;; org.clojure/tools.logging deliberately SHADOWS the real upstream
 ;; org.clojure/tools.logging coordinate — any transitive dependency
 ;; that pulls in the real clojure.tools.logging gets this jolt-lang
 ;; shim instead. Not a coordinate-naming inconsistency to "fix."
 :deps {weavejester/hiccup
        {:git/url "https://github.com/weavejester/hiccup"
         :git/sha "b6b12097ba973141fe87c1b4d6a27ddcce5d5929"}
        io.github.jolt-lang/time
        {:git/url "https://github.com/jolt-lang/time"
         :git/sha "5104b050e331ff4fadd7488c958bf121ca5c91d9"}
        org.clojure/tools.logging
        {:git/url "https://github.com/jolt-lang/logging"
         :git/sha "35b73131991336d6d008078016f2f87497fa713d"}

        ;; Pinned now that both are pushed (was :local/root while local-only
        ;; per the extraction plan). Mirrors how glitter-uikit/glitter-gl
        ;; pin glitter itself. glitter-core declares :jolt/min-version
        ;; "0.8.0" and nexus-jolt "0.7.24", both below glitter's own floor
        ;; above. As of 2026-11-19 both repos' main is 4 commits past these
        ;; pins, all in CI and bb.edn, so there is nothing to bump for.
        io.github.jlt-commons/glitter-core
        {:git/url "https://github.com/jlt-commons/glitter-core"
         :git/sha "4fba1ddb069be798adc1ef0c028e6e21a21ec9f3"}
        io.github.jlt-commons/nexus-jolt
        {:git/url "https://github.com/jlt-commons/nexus-jolt"
         :git/sha "18363987bed79f3ec98aaaf6c274cb01dfff88e7"}}

 ;; GTK4 and its GLib dependencies, bound natively via jolt.ffi. Identical
 ;; declarations to glimmer's own deps.edn (jolt-lang/glimmer) — glitter
 ;; targets the same native libraries, just a different reconciler on top.
 :jolt/native [{:name "glib-2.0"
                :darwin ["/opt/homebrew/lib/libglib-2.0.0.dylib"
                         "/usr/local/lib/libglib-2.0.0.dylib"
                         "libglib-2.0.0.dylib"
                         "libglib-2.0.dylib"]
                :linux  ["libglib-2.0.so.0"
                         "libglib-2.0.so"]}
               {:name "gobject-2.0"
                :darwin ["/opt/homebrew/lib/libgobject-2.0.0.dylib"
                         "/usr/local/lib/libgobject-2.0.0.dylib"
                         "libgobject-2.0.0.dylib"
                         "libgobject-2.0.dylib"]
                :linux  ["libgobject-2.0.so.0"
                         "libgobject-2.0.so"]}
               {:name "gio-2.0"
                :darwin ["/opt/homebrew/lib/libgio-2.0.0.dylib"
                         "/usr/local/lib/libgio-2.0.0.dylib"
                         "libgio-2.0.0.dylib"
                         "libgio-2.0.dylib"]
                :linux  ["libgio-2.0.so.0"
                         "libgio-2.0.so"]}
               {:name "gtk-4"
                :darwin ["/opt/homebrew/lib/libgtk-4.1.dylib"
                         "/usr/local/lib/libgtk-4.1.dylib"
                         "libgtk-4.1.dylib"
                         "libgtk-4.dylib"]
                :linux  ["libgtk-4.so.1"
                         "libgtk-4.so"]}]

