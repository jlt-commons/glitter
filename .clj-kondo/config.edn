;; clj-kondo configuration for glitter.
;;
;; jolt.ffi/defcfn defines a var per bound C symbol. clj-kondo cannot see
;; through the macro, so hooks/jolt_ffi.clj rewrites each call into an
;; equivalent `defn` — see that file for why. Without it the suite reports
;; ~190 false positives (every gtk-*/g-* binding in glitter.ffi, plus every
;; call site through the g/ alias) and the linter is unusable as a gate.
{:hooks {:analyze-call {jolt.ffi/defcfn hooks.jolt-ffi/defcfn}}

 ;; glitter.alias/defalias registers `name` to a keyword AND defs it, with
 ;; an argument vector + body shape matching defn closely enough that
 ;; :lint-as (no custom hook needed) resolves the defined var and its
 ;; destructured params correctly — without this, every defalias site
 ;; reports 3 false "Unresolved symbol" errors (the alias name at its own
 ;; call sites, plus every destructured arg inside the body).
 :lint-as {glitter.alias/defalias clojure.core/defn}

 ;; These 10 files are ported verbatim from Replicant (see NOTICE /
 ;; docs/guide/porting-and-attribution.md) and deliberately keep
 ;; #?(:clj :cljs) reader conditionals in a .clj extension — a mechanical
 ;; sed rename from Replicant's original .cljc, not a bug. Standard Clojure
 ;; tooling restricts reader conditionals to .cljc, so every one of those
 ;; forms is a PERMANENT "Reader conditionals are only allowed in .cljc
 ;; files" finding — real syntax Jolt itself parses and runs correctly
 ;; (jolt -M:test proves that), just not what clj-kondo expects from this
 ;; extension. It's a "syntax"-class finding, which isn't gated by
 ;; :linters levels the way ordinary lint warnings are, so exclusion here
 ;; is the only fix — this is exactly the pattern b12n-sumo-app's
 ;; .clj-kondo/config.edn uses to exclude ClojureDart source clj-kondo
 ;; can't parse (see ~/dev/b12n-wikis/b12n-sumo-app/
 ;; developer-workflow-and-bb-tasks.md). Scoping this here (not just in
 ;; bb.edn's task command lines) means `clj-kondo --lint src test examples`
 ;; is safe to run directly — an editor's clojure-lsp pass or an
 ;; accidental un-scoped invocation can't reintroduce the flood.
 :output {:exclude-files ["glitter/protocols\\.clj$"
                          "glitter/hiccup\\.clj$"
                          "glitter/hiccup_headers\\.clj$"
                          "glitter/console_logger\\.clj$"
                          "glitter/errors\\.clj$"
                          "glitter/assert\\.clj$"
                          "glitter/vdom\\.clj$"
                          "glitter/asserts\\.clj$"
                          "glitter/core\\.clj$"
                          "glitter/alias\\.clj$"]}}
