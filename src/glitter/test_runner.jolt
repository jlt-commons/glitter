(ns glitter.test-runner
  (:require [clojure.test]
            [glitter.hiccup-test]
            [glitter.assert-test]
            [glitter.asserts-test]
            [glitter.core-test]))

(defn -main [& args]
  (clojure.test/run-tests 'glitter.hiccup-test 'glitter.assert-test 'glitter.asserts-test 'glitter.core-test))
